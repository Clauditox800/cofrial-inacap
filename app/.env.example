# Copiar como .env y completar (chmod 600 .env)
PORT=3000

# Amazon RDS (endpoint en la consola de RDS > Conectividad)
DB_HOST=cofrial-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=cambiar-esta-clave
DB_NAME=cofrial

# Firma de sesiones (cualquier texto largo y aleatorio)
JWT_SECRET=cambiar-por-un-texto-largo-aleatorio

# Secreto compartido con los dispositivos IoT (mismo valor en iot/.env)
IOT_SECRET=cambiar-secreto-iot

# IA (opcional): clave gratuita en https://aistudio.google.com/apikey
# Si se deja vacía, se usa el clasificador por reglas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
